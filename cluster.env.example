# Copy to cluster.env and adjust for your deployment. Do not commit cluster.env.
# Values below match the verified four-node ZeroTier cluster; replace for another cluster.

# Node addresses (ZeroTier)
export NODE1_IP=10.145.6.116   # Ingestion
export NODE2_IP=10.145.6.245   # HDFS NameNode, DataNode, Spark Worker
export NODE3_IP=10.145.6.188   # Spark Master, Spark Worker, HDFS DataNode
export NODE4_IP=10.145.6.187   # FastAPI and React

# HDFS and Iceberg
export HDFS_URI=hdfs://${NODE2_IP}:9000
export WAREHOUSE_URI=${HDFS_URI}/warehouse
export ICEBERG_TABLE=lake.search.documents

# Spark
export SPARK_MASTER_URL=spark://${NODE3_IP}:7077
export ICEBERG_JAR=lib/iceberg-spark-runtime-3.3_2.12-1.8.1.jar

# Serving
export SEARCH_EXPORT_PATH=$HOME/distributed-search-engine/serving/phase0

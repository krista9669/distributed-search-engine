# Copy to cluster.env (repository root) and adjust. Do not commit cluster.env.
# scripts/phase1_live.sh runs `source cluster.env`, so the Node 1 variables
# below are required. Values match the verified four-node ZeroTier cluster;
# replace them for another cluster.

# ---- Node addresses (ZeroTier) ----------------------------------------------
export N1IP=10.145.6.116       # Node 1: ingestion (Spark driver for Node 1 jobs)
# Node 2 10.145.6.245: HDFS NameNode, DataNode, Spark Worker
# Node 3 10.145.6.188: Spark Master, Spark Worker, HDFS DataNode
# Node 4 10.145.6.187: FastAPI and React

# ---- Node 1: ingestion and verification (used by scripts/phase1_live.sh) ----
export HADOOP_CONF_DIR=$HOME/hadoop-client-conf
export NN=hdfs://10.145.6.245:9000                 # HDFS NameNode
export MASTER=spark://10.145.6.188:7077            # Spark master
export CAT=lake                                    # Iceberg catalog name
export TBL=search.documents                        # production table (catalog.TBL = lake.search.documents)
export WH=hdfs://10.145.6.245:9000/warehouse       # Iceberg warehouse
export ICEBERG_JAR=$HOME/distributed-search-engine/lib/iceberg-spark-runtime-3.3_2.12-1.8.1.jar
export PYSPARK_SUBMIT_ARGS="--conf spark.driver.bindAddress=0.0.0.0 --conf spark.executor.memory=1g --conf spark.executorEnv.PYSPARK_PYTHON=python3.10 --conf spark.network.timeout=600s --conf spark.executor.heartbeatInterval=60s --conf spark.rpc.askTimeout=600s --conf spark.task.maxFailures=8 pyspark-shell"

# ---- Node 3: processing (optional; scripts/node3_run.sh has the same defaults) ----
# export DRIVER_HOST=10.145.6.188
# export SPARK_HOME=/opt/spark
# export DERIVED_BASE=/derived
# export PAGERANK_ITERATIONS=10

# ---- Node 4: serving ----------------------------------------------------------
# The backend does NOT read .env files; export this in the shell that starts uvicorn.
# export SEARCH_EXPORT_PATH=$HOME/distributed-search-engine/serving/phase0
